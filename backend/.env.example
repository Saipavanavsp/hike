# Copy to backend/.env for running the API outside Docker.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://hike:hike@localhost:5432/hike
REDIS_URL=redis://localhost:6379/0
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

STORAGE_BACKEND=local
STORAGE_DIR=./storage
# S3-compatible storage (Cloudflare R2, AWS S3, MinIO) when STORAGE_BACKEND=s3
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# onnx (default, light) or sentence-transformers (reference, needs torch)
EMBEDDING_BACKEND=onnx
MODEL_DIR=

SEED_ON_START=false

# Background jobs: true = run inline (no worker needed); false = queue for
#   celery -A app.worker worker --beat --loglevel=INFO
TASKS_EAGER=true
TASK_MAX_RETRIES=3

# Email: log (write to the hike.email logger) or smtp (Brevo, Resend, SES, Gmail, ...)
EMAIL_BACKEND=log
EMAIL_FROM=Hike <no-reply@hike.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Links in emails and calendar invites point here
PUBLIC_APP_URL=http://localhost:8080

# Observability
LOG_FORMAT=text
LOG_LEVEL=INFO
SENTRY_DSN=
# If set, /metrics requires "Authorization: Bearer <token>"
METRICS_TOKEN=

# Resume privacy and security
# Any secret string; empty = derived from JWT_SECRET. Changing it makes stored files unreadable.
FILE_ENCRYPTION_KEY=
SIGNED_URL_TTL_SECONDS=300
# heuristic (built-in checks) or clamav (built-in checks + ClamAV daemon)
MALWARE_SCAN=heuristic
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# subprocess (sandboxed, resource-limited) or inline
PARSER_ISOLATION=subprocess
PARSER_TIMEOUT_SECONDS=20
PARSER_MEMORY_MB=512
CONSENT_VERSION=2026-11
# Retention in days; 0 disables a rule
RETENTION_UNCONFIRMED_DAYS=7
RETENTION_OLD_RESUME_DAYS=365
RETENTION_INACTIVE_SEEKER_DAYS=0
