# Copy to backend/.env for running the API outside Docker.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://hike:hike@localhost:5432/hike
REDIS_URL=redis://localhost:6379/0
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

STORAGE_BACKEND=local
STORAGE_DIR=./storage
# S3-compatible storage (Cloudflare R2, AWS S3, MinIO) when STORAGE_BACKEND=s3
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# onnx (default, light) or sentence-transformers (reference, needs torch)
EMBEDDING_BACKEND=onnx
MODEL_DIR=

SEED_ON_START=false
